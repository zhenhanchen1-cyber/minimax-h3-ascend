+
+    monkeypatch.setattr(comfy.multinpu.ctypes, "CDLL", lambda _: FakeHccl())
+    devices = (torch.device("npu:0"), torch.device("npu:1"))
+
+    communicator = comfy.multinpu.HcclLocalCommunicator(devices)
